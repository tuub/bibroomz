[Unit]
Description=BibRoomz queue worker for review app %i

[Service]
Type=simple
WorkingDirectory=/srv/review/apps/%i
ExecStart=/usr/bin/env php artisan queue:work --sleep=3 --tries=3 --timeout=90 --max-time=3600
ExecReload=/usr/bin/env php artisan queue:restart
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=default.target
