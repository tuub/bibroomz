*
!app/
!artisan
# bootstrap/cache is listed by its .gitignore alone. The final stage copies this
# context and runs no composer, so a manifest from a development machine would
# be the one it boots, naming providers the image does not have.
!bootstrap/app.php
!bootstrap/cache/.gitignore
!composer.json
!composer.lock
!config/
!database/
!lang/
!package-lock.json
!package.json
!postcss.config.ts
!public/images/
!public/index.php
!public/robots.txt
!resources/
!routes/
!storage/.gitignore
!storage/app/.gitignore
!storage/app/public/.gitignore
!storage/framework/cache/.gitignore
!storage/framework/cache/data/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/views/.gitignore
!storage/logs/.gitignore
!tailwind.config.ts
!tsconfig.json
!vite.config.ts
