{
    "name": "tuub/bibroomz",
    "type": "project",
    "description": "BibRoomz",
    "keywords": ["room", "reservation", "php", "laravel", "libraries", "reservation-system", "vue3"],
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.3",
        "bkwld/cloner": "^3.15.0",
        "cybercog/laravel-ban": "^4.11",
        "fakerphp/faker": "^1.24.1",
        "guzzlehttp/guzzle": "^7.11.0",
        "inertiajs/inertia-laravel": "^2.0.24",
        "ixudra/curl": "^6.23",
        "laravel/framework": "^11.54",
        "laravel/prompts": "^0.1.25",
        "laravel/pulse": "^1.7.3@beta",
        "laravel/reverb": "^1.10.2",
        "laravel/sanctum": "^4.3.2",
        "laravel/tinker": "^2.11.1",
        "pusher/pusher-php-server": "^7.2.8",
        "spatie/laravel-translatable": "^6.14.1",
        "tightenco/ziggy": "^2.6.2",
        "vyuldashev/xml-to-array": "^1.1"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.4.0",
        "larastan/larastan": "^3.10",
        "laravel-lang/common": "^3.1.1",
        "laravel/pint": "^1.29.1",
        "laravel/sail": "^1.61.0",
        "laravel/telescope": "^5.20",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.4",
        "pestphp/pest": "^4.7.2",
        "pestphp/pest-plugin-browser": "^4.3.1",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "rector/rector": "^2.4.5",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test:browser": [
            "@php scripts/test-browser.php"
        ],
        "test:feature": [
            "@pest --testsuite=Feature"
        ],
        "test:unit": [
            "@pest --testsuite=Unit"
        ],
        "coverage:feature": [
            "@pest --testsuite=Feature --coverage --coverage-cobertura build/coverage/cobertura-feature.xml"
        ],
        "coverage:unit": [
            "@pest --testsuite=Unit --coverage --coverage-cobertura build/coverage/cobertura-unit.xml"
        ],
        "mutate:feature": [
            "@pest --testsuite=Feature --mutate --covered-only --parallel"
        ],
        "mutate:unit": [
            "@pest --testsuite=Unit --mutate --covered-only --parallel"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pest": [
            "pest --cache-directory=/tmp/phpunit-cache --display-all-issues --parallel"
        ],
        "check": [
            "rector --dry-run",
            "pint --test",
            "phpstan"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
